        <activity
            android:name=".AdminListaPQRSActivity"
            android:exported="false" />
        <activity
            android:name=".AdminPQRSDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".DatosPQRSActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ConsultarPQRSActivity"
            android:exported="false" />
