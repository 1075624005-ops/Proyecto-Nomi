<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1. PALETA BASE (Los colores puros - Literales) -->
    <color name="palette_black">#000000</color>
    <color name="palette_white">#FFFFFF</color>
    <color name="palette_cyan_nomi">#00AEEF</color>
    <color name="palette_dark_gray">#12121A</color>
    <color name="palette_gray_input">#1A1A24</color>
    <color name="palette_muted">#A0A0A0</color>
    <color name="palette_error">#D32F2F</color>
    <color name="palette_whatsapp">#25D366</color>

    <!-- 2. VARIABLES SEMÁNTICAS (Lógica de Diseño) -->
    <!-- Cambia estas para rediseñar la app sin romper nada -->

    <!-- Fondos y Superficies -->
    <color name="app_background">@color/palette_black</color>
    <color name="app_surface_card">@color/palette_dark_gray</color>
    <color name="app_input_background">@color/palette_gray_input</color>

    <!-- Textos -->
    <color name="text_primary">@color/palette_white</color>
    <color name="text_secondary">@color/palette_muted</color>
    <color name="text_accent">@color/palette_cyan_nomi</color>
    <color name="text_error">@color/palette_error</color>

    <!-- Elementos Interactivos -->
    <color name="brand_primary">@color/palette_cyan_nomi</color>
    <color name="brand_outline">@color/palette_cyan_nomi</color>
    <color name="icon_active">@color/palette_cyan_nomi</color>

    <!-- 3. COLORES FIJOS (Los que NO deben cambiar por diseño) -->
    <color name="fixed_white">#FFFFFF</color>
    <color name="fixed_black">#000000</color>
    <color name="fixed_whatsapp">@color/palette_whatsapp</color>

    <!-- Auxiliares para PQRS y Estados -->
    <color name="status_pending_bg">#FFF3CD</color>
    <color name="status_pending_text">#856404</color>
    <color name="status_resolved_bg">#D4EDDA</color>
    <color name="status_resolved_text">#155724</color>

    <!-- ALIAS TEMPORALES PARA COMPATIBILIDAD (Para evitar errores de compilación) -->
    <color name="bg_main">@color/app_background</color>
    <color name="bg_card">@color/app_surface_card</color>
    <color name="bg_dark_variant">#0F0F14</color>
    <color name="bg_input">@color/app_input_background</color>
    <color name="brand_cyan">@color/brand_primary</color>
    <color name="text_white">@color/text_primary</color>
    <color name="text_hint">#888888</color>
    <color name="text_muted">@color/text_secondary</color>
    <color name="text_light_gray">#CCCCCC</color>
    <color name="border_gray">#333333</color>
    <color name="error_red">@color/palette_error</color>
</resources>
