<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- TOOLBAR SUPERIOR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/app_surface_card"
        android:paddingTop="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVolverUsuarios"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 GESTIÓN DE USUARIOS"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BARRA DE BÚSQUEDA Y FILTROS -->
    <LinearLayout
        android:id="@+id/llFiltrosUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarUsuarios">

        <EditText
            android:id="@+id/etBuscarUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Buscar por nombre, correo o documento..."
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFiltroTodos"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="Todos"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    app:strokeColor="@color/brand_primary" />

                <Button
                    android:id="@+id/btnFiltroClientes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="Clientes"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:strokeColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnFiltroAsesores"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="Asesores"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:strokeColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnFiltroMensajeros"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="Mensajeros"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:strokeColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnFiltroAdmins"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Admins"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:strokeColor="@color/text_secondary" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- INDICADOR DE CARGA -->
    <ProgressBar
        android:id="@+id/pbCargaUsuarios"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llFiltrosUsuarios" />

    <!-- LISTA DE USUARIOS -->
    <ListView
        android:id="@+id/lvUsuarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@null"
        android:dividerHeight="10dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/tvFooterUsuarios"
        app:layout_constraintTop_toBottomOf="@id/llFiltrosUsuarios" />

    <!-- MENSALE SIN RESULTADOS -->
    <TextView
        android:id="@+id/tvSinUsuarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se encontraron usuarios registrados"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llFiltrosUsuarios" />

    <!-- FOOTER CON RESUMEN -->
    <TextView
        android:id="@+id/tvFooterUsuarios"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/brand_primary"
        android:gravity="center"
        android:text="Total Registrados en Supabase: 0"
        android:textColor="@color/app_background"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>