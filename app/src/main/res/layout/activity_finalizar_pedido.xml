<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgLogoFinal"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_nomi"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTituloFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRMACIÓN DE PEDIDO"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogoFinal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- PASO 4: RESUMEN TOTAL -->
        <TextView
            android:id="@+id/tvPaso4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. VERIFIQUE SU INFORMACIÓN"
            android:textColor="#00AEEF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloFinal"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- TARJETA: ORIGEN Y DESTINO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvPaso4">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">
                <TextView android:text="RUTA DEL ENVÍO" android:textColor="#00AEEF" android:textStyle="bold" android:textSize="12sp" />
                <TextView android:id="@+id/tvResumenRem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="De: -" android:textColor="#FFFFFF" android:layout_marginTop="5dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="8dp"/>
                <TextView android:id="@+id/tvResumenDest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Para: -" android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA: DETALLES DEL PAQUETE -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvDetallePaquete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/cvRuta">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">
                <TextView android:text="DETALLE DEL PEDIDO" android:textColor="#00AEEF" android:textStyle="bold" android:textSize="12sp" />
                <TextView android:id="@+id/tvResumenPedido" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contenido: -" android:textColor="#FFFFFF" android:layout_marginTop="5dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA: PAGO Y TIEMPO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvPagoFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/cvDetallePaquete">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">
                <TextView android:id="@+id/tvResumenPago" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modalidad: -" android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvTotalFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOTAL A PAGAR: $0"
                    android:textColor="#4CAF50"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN CONFIRMAR -->
        <Button
            android:id="@+id/btnConfirmarPedido"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CONFIRMAR PEDIDO"
            android:backgroundTint="#00AEEF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/cvPagoFinal" />

        <Button
            android:id="@+id/btnModificarPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODIFICAR DATOS"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintTop_toBottomOf="@id/btnConfirmarPedido"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
