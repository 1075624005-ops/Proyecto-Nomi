<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout_pedidos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:id="@+id/scrollDestinatario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:isScrollContainer="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_destinatario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:paddingBottom="100dp">

            <ImageView
                android:id="@+id/imgLogoAdmin"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:src="@drawable/logo_nomi"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="NUEVO PEDIDO"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgLogoAdmin" />

            <TextView
                android:id="@+id/lbDatosDelDestinatario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="2. DATOS DEL DESTINATARIO"
                android:textColor="#00AEEF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/lbDatosDelDestinatario">

                <EditText
                    android:id="@+id/etNombreDestinatario"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Nombre del Destinatario"
                    android:inputType="textPersonName"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999" />

                <EditText
                    android:id="@+id/etTelefonoDestinatario"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Teléfono de contacto"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999" />

                <EditText
                    android:id="@+id/etcorreoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Correo Electronico"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Localidad de Entrega (Bogotá)"
                    android:textColor="#00AEEF"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spLocalidadDestino"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginTop="5dp" />

                <EditText
                    android:id="@+id/etDireccionDestinatario"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Dirección de entrega"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999" />

                <Button
                    android:id="@+id/btnSiguienteDestinatario"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="30dp"
                    android:backgroundTint="#00AEEF"
                    android:text="SIGUIENTE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnVolverRemitente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#333333"
                    android:text="VOLVER"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>