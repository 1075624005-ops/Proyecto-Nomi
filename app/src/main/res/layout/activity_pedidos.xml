<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout_pedidos_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_pedidos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">
        <ImageView
            android:id="@+id/imgLogoAdmin"
            android:layout_width="60dp"
            android:layout_height="55dp"
            android:src="@drawable/logo_nomi"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Logo" />
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUEVO PEDIDO"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogoAdmin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <Button
            android:id="@+id/btnIrARemitente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            android:text="REGISTRAR REMITENTE"
            android:backgroundTint="#00AEEF"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"/>
        <Button
            android:id="@+id/btnRegresarAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="VOLVER AL PANEL"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/btnIrARemitente"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.drawerlayout.widget.DrawerLayout>