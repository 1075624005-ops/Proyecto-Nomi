<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvAdminDetalleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DETALLES DE LA SOLICITUD"
            android:textColor="@color/brand_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- FICHA DEL CLIENTE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFicha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/app_surface_card"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvAdminDetalleTitle">

            <LinearLayout
                android:id="@+id/llFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/detNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre: ..."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detTipoPers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tipo: ..."
                    android:textColor="@color/text_light_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detDoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Documento: ..."
                    android:textColor="@color/text_light_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Correo: ..."
                    android:textColor="@color/text_light_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detDir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Dirección: ..."
                    android:textColor="@color/text_light_gray"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SITUACIÓN REPORTADA -->
        <TextView
            android:id="@+id/lbSituacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SITUACIÓN REPORTADA:"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardFicha" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSituacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/app_surface_card"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/border_gray"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/lbSituacion">

            <TextView
                android:id="@+id/detDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="..."
                android:textColor="@color/text_white"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- CAMPO DE RESPUESTA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRespuesta"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Escriba aquí su respuesta para el cliente..."
            android:textColorHint="@color/text_hint"
            app:boxBackgroundColor="@color/app_surface_card"
            app:boxStrokeColor="@color/brand_primary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="12dp"
            app:hintTextColor="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/cardSituacion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdminRespuesta"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="@color/text_white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN ENVIAR RESPUESTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminEnviarResp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/brand_primary"
            android:text="ENVIAR RESPUESTA"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilRespuesta" />

        <!-- BOTÓN VOLVER -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminVolver"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:text="VOLVER"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_cyan"
            app:strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnAdminEnviarResp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>