<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- LOGO Y TÍTULO -->
        <ImageView
            android:id="@+id/imgLogoCotizar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Logo NOMI"
            android:src="@drawable/logo_nomi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTituloCotizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cotiza tu envío"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogoCotizar" />

        <!-- ORIGEN Y DESTINO EN TARJETA -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/app_surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloCotizar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Origen"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <AutoCompleteTextView
                        android:id="@+id/etOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:completionThreshold="1"
                        android:hint="Ciudad origen"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="Flecha"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/brand_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destino"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <AutoCompleteTextView
                        android:id="@+id/etDestino"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:completionThreshold="1"
                        android:hint="Ciudad destino"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DIMENSIONES (ANCHO, LARGO, ALTO) -->
        <TextView
            android:id="@+id/tvLabelMedidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Dimensiones (cm)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardRuta" />

        <GridLayout
            android:id="@+id/gridMedidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            app:layout_constraintTop_toBottomOf="@id/tvLabelMedidas">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_columnWeight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ancho"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAncho"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_columnWeight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Largo"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etLargo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_columnWeight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alto"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAlto"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </GridLayout>

        <!-- PESO Y VALORES -->
        <TextView
            android:id="@+id/tvLabelPesos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pesos y Valor Declarado"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridMedidas" />

        <GridLayout
            android:id="@+id/gridPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPesos">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_columnWeight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peso Real (Kg)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPeso"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_columnWeight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P. Volumétrico"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPesoVol"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:enabled="false"
                    android:gravity="center"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_columnWeight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V. Declarado ($)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etValorDec"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </GridLayout>

        <!-- TABLA DE VALORES -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvTablaValores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/app_surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/gridPeso">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:text="Tabla de tarifas estimadas"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <TableRow>
                        <TextView
                            android:padding="6dp"
                            android:text="Peso"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:gravity="end"
                            android:padding="6dp"
                            android:text="Valor Base"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="6dp"
                            android:text="Hasta 1 Kg"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                        <TextView
                            android:gravity="end"
                            android:padding="6dp"
                            android:text="$ 10.000"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="6dp"
                            android:text="Hasta 2 Kg"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                        <TextView
                            android:gravity="end"
                            android:padding="6dp"
                            android:text="$ 13.000"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="6dp"
                            android:text="Hasta 3 Kg"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                        <TextView
                            android:gravity="end"
                            android:padding="6dp"
                            android:text="$ 16.000"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="6dp"
                            android:text="Kg Adicional"
                            android:textColor="#4CAF50"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:gravity="end"
                            android:padding="6dp"
                            android:text="+ $ 3.000"
                            android:textColor="#4CAF50"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="* El valor final depende del destino y el manejo de mercancía."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- RESULTADO (TARJETA DESTACADA) -->
        <LinearLayout
            android:id="@+id/llResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/app_surface_card"
            app:layout_constraintTop_toBottomOf="@id/cvTablaValores">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Valor estimado del envío:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_rounded"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="$ 0"
                android:textColor="@color/brand_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTONES PRINCIPALES -->
        <LinearLayout
            android:id="@+id/llBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/llResultado">

            <!-- BOTÓN CONTACTO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnContactoCotizar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/app_surface_card"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Llamar"
                        android:src="@android:drawable/ic_menu_call"
                        app:tint="@color/brand_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Contacto"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTÓN CALCULAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcular"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/brand_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Calcular"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- FOOTER DISCRETO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="Trabajamos día a día para ser tu mejor solución"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llBotones" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
