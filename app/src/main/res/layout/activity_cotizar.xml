<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- LOGO Y TÍTULO -->
        <ImageView
            android:id="@+id/imgLogoCotizar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_nomi"
            android:contentDescription="Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTituloCotizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cotiza tu Envío"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogoCotizar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ORIGEN Y DESTINO -->
        <LinearLayout
            android:id="@+id/llRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloCotizar">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Origen" android:textColor="#FFFFFF" android:textStyle="bold" />
                <AutoCompleteTextView
                    android:id="@+id/etOrigen"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Ciudad"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:completionThreshold="1" />
            </LinearLayout>

            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@android:drawable/ic_media_play" app:tint="#00AEEF" android:layout_marginTop="10dp" android:contentDescription="Flecha" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Destino" android:textColor="#FFFFFF" android:textStyle="bold" />
                <AutoCompleteTextView
                    android:id="@+id/etDestino"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Ciudad"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:completionThreshold="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- DIMENSIONES -->
        <GridLayout
            android:id="@+id/gridMedidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/llRuta">

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1">
                <TextView android:text="Ancho" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etAncho" android:layout_width="match_parent" android:layout_height="40dp" android:background="@android:drawable/editbox_background_normal" android:inputType="numberDecimal" android:gravity="center" android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1">
                <TextView android:text="Largo" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etLargo" android:layout_width="match_parent" android:layout_height="40dp" android:background="@android:drawable/editbox_background_normal" android:inputType="numberDecimal" android:gravity="center" android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1">
                <TextView android:text="Alto" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etAlto" android:layout_width="match_parent" android:layout_height="40dp" android:background="@android:drawable/editbox_background_normal" android:inputType="numberDecimal" android:gravity="center" android:textColor="#000000" />
            </LinearLayout>
        </GridLayout>

        <!-- PESO Y VALORES -->
        <GridLayout
            android:id="@+id/gridPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/gridMedidas">

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1">
                <TextView android:text="Peso Real" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etPeso" android:layout_width="match_parent" android:layout_height="40dp" android:background="@android:drawable/editbox_background_normal" android:inputType="numberDecimal" android:gravity="center" android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1">
                <TextView android:text="P. Volumétrico" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etPesoVol" android:layout_width="match_parent" android:layout_height="40dp" android:background="@android:drawable/editbox_background_normal" android:enabled="false" android:gravity="center" android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1">
                <TextView android:text="V. Declarado" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etValorDec" android:layout_width="match_parent" android:layout_height="40dp" android:background="@android:drawable/editbox_background_normal" android:inputType="number" android:gravity="center" android:textColor="#000000" />
            </LinearLayout>
        </GridLayout>

        <!-- TABLA DE VALORES -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvTablaValores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/gridPeso">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TABLA DE TARIFAS ESTIMADAS"
                    android:textColor="#00AEEF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <TableRow>
                        <TextView android:text="Peso" android:textColor="#00AEEF" android:textStyle="bold" android:padding="4dp"/>
                        <TextView android:text="Valor Base" android:textColor="#00AEEF" android:textStyle="bold" android:padding="4dp" android:gravity="end"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Hasta 1 Kg" android:textColor="#FFFFFF" android:padding="4dp"/>
                        <TextView android:text="$ 10.000" android:textColor="#FFFFFF" android:padding="4dp" android:gravity="end"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Hasta 2 Kg" android:textColor="#FFFFFF" android:padding="4dp"/>
                        <TextView android:text="$ 13.000" android:textColor="#FFFFFF" android:padding="4dp" android:gravity="end"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Hasta 3 Kg" android:textColor="#FFFFFF" android:padding="4dp"/>
                        <TextView android:text="$ 16.000" android:textColor="#FFFFFF" android:padding="4dp" android:gravity="end"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Kg Adicional" android:textColor="#4CAF50" android:textStyle="bold" android:padding="4dp"/>
                        <TextView android:text="+ $ 3.000" android:textColor="#4CAF50" android:padding="4dp" android:gravity="end"/>
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* El valor final depende del destino y el manejo de mercancía."
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- RESULTADO -->
        <LinearLayout
            android:id="@+id/llResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/cvTablaValores">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tu Envío vale"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="140dp"
                android:layout_height="45dp"
                android:background="@android:drawable/editbox_background_normal"
                android:gravity="center"
                android:text="$ 0"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTONES -->
        <LinearLayout
            android:id="@+id/llBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/llResultado">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnContactoCotizar"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#00AEEF"
                app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_call" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contáctenos" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View android:layout_width="15dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:text="CALCULAR"
                android:backgroundTint="#00AEEF"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:background="#00AEEF"
            android:gravity="center"
            android:text="Trabajamos día a día para ser tu mejor solución."
            android:textColor="#000000"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/llBotones"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
