<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_messenger"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOOLBAR ENCABEZADO -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbarMessenger"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/app_surface_card"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenuMessenger"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="20dp"
                android:contentDescription="Menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_primary" />

            <ImageView
                android:id="@+id/imgLogoMessenger"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Logo"
                android:src="@drawable/logo_nomi"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvMessengerWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="PANEL DE MENSAJERÍA"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgLogoMessenger" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CONTENIDO PRINCIPAL DASHBOARD -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/vFooterMessenger"
            app:layout_constraintTop_toBottomOf="@id/toolbarMessenger">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvWelcomeMensajeroText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:text="Bienvenido Domiciliario"
                    android:textColor="@color/brand_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- BOTÓN 1: PEDIDOS ASIGNADOS / TAREAS DE HOY -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPedidosAsignados"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/app_surface_card"
                    android:gravity="center_vertical|start"
                    android:paddingStart="20dp"
                    android:text="🛵   PEDIDOS ASIGNADOS (RUTA DE HOY)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1dp" />

                <!-- BOTÓN 2: HISTORIAL DE ENTREGAS FINALIZADAS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistorialEntregas"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/app_surface_card"
                    android:gravity="center_vertical|start"
                    android:paddingStart="20dp"
                    android:text="📋   HISTORIAL DE ENTREGAS FINALIZADAS"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1dp" />

                <!-- BOTÓN 3: MI PERFIL -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPerfilMensajero"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/app_surface_card"
                    android:gravity="center_vertical|start"
                    android:paddingStart="20dp"
                    android:text="👤   MI PERFIL DE DOMICILIARIO"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1dp" />

                <!-- BOTÓN 4: CENTRO DE ATENCIÓN Y SOPORTE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSoporteMensajero"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/app_surface_card"
                    android:gravity="center_vertical|start"
                    android:paddingStart="20dp"
                    android:text="📞   CENTRO DE SOPORTE"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </ScrollView>

        <!-- FOOTER MODO MENSAJERO -->
        <TextView
            android:id="@+id/vFooterMessenger"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/brand_primary"
            android:gravity="center"
            android:text="Modo Domiciliario - NOMI"
            android:textColor="@color/app_background"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL (DRAWER) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_messenger"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/app_surface_card"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/brand_primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/messenger_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>