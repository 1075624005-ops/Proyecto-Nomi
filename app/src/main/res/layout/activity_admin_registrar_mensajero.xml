<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:paddingBottom="200dp"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerRegM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/tvRegTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALTA DE MENSAJERO"
            android:textColor="@color/brand_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvRegTitle">

            <!-- NOMBRE COMPLETO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre Completo"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CÉDULA -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Cédula / Número de Documento"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCedulaRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TELÉFONO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Teléfono / Móvil de Contacto"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefonoRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CORREO ELECTRÓNICO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Correo Electrónico (Login)"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreoRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PLACA DEL VEHÍCULO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Placa del Vehículo (ej. XYZ-123)"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlacaRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ÁREA / ZONA -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Área / Zona Asignada de Bogotá"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAreaRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONTRASEÑA PROVISIONAL CON MOSTRAR/OCULTAR (OJO) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassRegM"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Contraseña Provisional de Acceso"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/app_background"
                app:boxStrokeColor="@color/text_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:cornerRadius="12dp"
                app:hintTextColor="@color/text_primary"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/brand_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassRegM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalizarRegM"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/brand_primary"
                android:text="REGISTRAR EN PLANILLA"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarRegM"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CANCELAR"
                android:textColor="@color/palette_error" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>