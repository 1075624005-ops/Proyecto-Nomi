<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- CABECERA DE RÓTULO CON LOGO Y CÓDIGO QR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LADO IZQUIERDO: LOGO, NOMI, SOLUCIONES Y RÓTULO -->
        <LinearLayout
            android:id="@+id/llPdfHeaderLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPdfLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Logo Nomi"
                android:src="@drawable/logo_nomi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="NOMI"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soluciones a tu alcance"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="RÓTULO DE ENVÍO"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LADO DERECHO: NÚMERO DE GUÍA Y CÓDIGO QR -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÚMERO DE GUÍA"
                android:textColor="#666666"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPdfGuia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N010002"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivPdfQr"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="6dp"
                android:contentDescription="Código QR del Pedido" />
        </LinearLayout>

    </RelativeLayout>

    <!-- LÍNEA SEPARADORA SUPERIOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#000000" />

    <!-- SECCIÓN REMITENTE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REMITENTE"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPdfRemitente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="Nombre: -\nDirección: -"
        android:textColor="#222222"
        android:textSize="13sp" />

    <!-- LÍNEA SEPARADORA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- SECCIÓN DESTINATARIO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENVIAR A (DESTINATARIO)"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPdfDestinatario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="Nombre: -\nDirección: -\nLocalidad: -\nTel: -"
        android:textColor="#222222"
        android:textSize="13sp" />

    <!-- LÍNEA SEPARADORA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- SECCIÓN CONTENIDO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTENIDO Y OBSERVACIONES"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPdfContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="Descripción: -\nServicio: -"
        android:textColor="#222222"
        android:textSize="13sp" />

    <!-- LÍNEA SEPARADORA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#CCCCCC" />

    <!-- SECCIÓN PAGO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvPdfEstadoPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAGO CONTRAENTREGA"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPdfMontoPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="POR PAGAR: $ 0"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LÍNEA SEPARADORA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- FOOTER LEGAL Y HABEAS DATA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tratamiento de datos conforme a la Ley 1581 de 2012 (Habeas Data)\nNOMI Express - Soluciones a tu alcance"
        android:textColor="#777777"
        android:textSize="10sp" />

</LinearLayout>