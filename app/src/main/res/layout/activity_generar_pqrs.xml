<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloGenerar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva PQRS"
            android:textColor="@color/brand_cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TIPO DE PQRS -->
        <TextView
            android:id="@+id/lbTipoPQRS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipo de solicitud:"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloGenerar" />

        <Spinner
            android:id="@+id/spTipoPQRS"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="@color/brand_cyan"
            app:layout_constraintTop_toBottomOf="@id/lbTipoPQRS" />

        <!-- ASUNTO -->
        <EditText
            android:id="@+id/etAsuntoPQRS"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Asunto (Ej: Retraso en entrega)"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/spTipoPQRS" />

        <!-- DESCRIPCION -->
        <EditText
            android:id="@+id/etDescPQRS"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:gravity="top"
            android:hint="Describa su situación detalladamente..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/etAsuntoPQRS" />

        <!-- AVISO TIEMPOS DE RESPUESTA -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTiempos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/etDescPQRS">

            <LinearLayout
                android:id="@+id/llTiemposRespuesta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="⏱ Tiempos de respuesta (Ley 1755/2015)"
                    android:textColor="@color/brand_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Petición / Queja / Reclamo: 15 días hábiles"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="• Consulta: 30 días hábiles"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="• Recibirá respuesta al correo registrado."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AUTORIZACIÓN USO DE DATOS PARA PQRS -->
        <LinearLayout
            android:id="@+id/llAutorizacionPQRS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/cardTiempos">

            <CheckBox
                android:id="@+id/cbAutorizacionPQRS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="@color/brand_cyan" />

            <TextView
                android:id="@+id/tvVerAutorizacionPQRS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:text="Autorizo el uso de mis datos para gestionar esta solicitud"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- BOTÓN ENVIAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarPQRS"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/brand_cyan"
            android:text="Enviar Solicitud"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/llAutorizacionPQRS" />

        <!-- BOTÓN CANCELAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPQRS"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            app:strokeColor="@color/text_muted"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEnviarPQRS" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>