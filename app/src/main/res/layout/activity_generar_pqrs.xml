<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:paddingBottom="80dp"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloGenerar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUEVA PQRS"
            android:textColor="#00AEEF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- TIPO DE PQRS -->
        <TextView
            android:id="@+id/lbTipoPQRS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de solicitud:"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloGenerar"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spTipoPQRS"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#00AEEF"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/lbTipoPQRS"/>

        <!-- ASUNTO -->
        <EditText
            android:id="@+id/etAsuntoPQRS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Asunto (Ej: Retraso en entrega)"
            android:textColor="#000000"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/spTipoPQRS"/>

        <!-- DESCRIPCION -->
        <EditText
            android:id="@+id/etDescPQRS"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:hint="Describa su situación detalladamente..."
            android:textColor="#000000"
            android:background="@android:drawable/editbox_background_normal"
            android:gravity="top"
            android:padding="12dp"
            android:inputType="textMultiLine"
            app:layout_constraintTop_toBottomOf="@id/etAsuntoPQRS"/>

        <!-- AVISO TIEMPOS DE RESPUESTA -->
        <LinearLayout
            android:id="@+id/llTiemposRespuesta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="#0D1B2A"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/etDescPQRS"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Tiempos de respuesta (Ley 1755/2015)"
                android:textColor="#00AEEF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Petición / Queja / Reclamo / Solicitud: 15 días hábiles"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Consulta: 30 días hábiles"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Recibirá respuesta al correo registrado."
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- AUTORIZACIÓN USO DE DATOS PARA PQRS -->
        <LinearLayout
            android:id="@+id/llAutorizacionPQRS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/llTiemposRespuesta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <CheckBox
                android:id="@+id/cbAutorizacionPQRS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00AEEF" />

            <TextView
                android:id="@+id/tvVerAutorizacionPQRS"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Autorizo el uso de mis datos para gestionar esta solicitud"
                android:textColor="#4FC3F7"
                android:textSize="13sp"
                android:paddingStart="6dp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- BOTÓN ENVIAR -->
        <Button
            android:id="@+id/btnEnviarPQRS"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ENVIAR SOLICITUD"
            android:backgroundTint="#00AEEF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/llAutorizacionPQRS"/>

        <Button
            android:id="@+id/btnCancelarPQRS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCELAR"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/btnEnviarPQRS"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>