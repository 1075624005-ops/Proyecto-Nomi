<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvPaso1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paso 1: Datos Personales"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- AVISO LEGAL PQRS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAvisoLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvPaso1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Info"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/brand_cyan" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="Ley 1755 de 2015 — Derecho de Petición. Su solicitud será respondida en máximo 15 días hábiles."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TIPO PERSONA -->
        <RadioGroup
            android:id="@+id/rgTipoPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/cardAvisoLegal">

            <RadioButton
                android:id="@+id/rbNatural"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Natural"
                android:textColor="@color/text_white"
                app:buttonTint="@color/brand_cyan" />

            <RadioButton
                android:id="@+id/rbJuridica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Jurídica"
                android:textColor="@color/text_white"
                app:buttonTint="@color/brand_cyan" />
        </RadioGroup>

        <!-- TIPO DE DOCUMENTO -->
        <TextView
            android:id="@+id/lbTipoDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipo de documento:"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rgTipoPersona" />

        <Spinner
            android:id="@+id/spTipoDocPQR"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="@color/brand_cyan"
            app:layout_constraintTop_toBottomOf="@id/lbTipoDoc" />

        <!-- NÚMERO DOCUMENTO -->
        <EditText
            android:id="@+id/etCedulaPQR"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Número de documento"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/spTipoDocPQR" />

        <!-- NOMBRE -->
        <EditText
            android:id="@+id/etNombrePQR"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Nombre completo / Razón social"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/etCedulaPQR" />

        <!-- CORREO -->
        <EditText
            android:id="@+id/etCorreoPQR"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/etNombrePQR" />

        <!-- DIRECCIÓN -->
        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Dirección de notificación"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/etCorreoPQR" />

        <!-- BOTÓN SIGUIENTE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguientePQR"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/brand_cyan"
            android:text="Siguiente"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etDireccion" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>