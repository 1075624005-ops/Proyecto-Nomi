<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogoRastreo"
            android:layout_width="65dp"
            android:layout_height="60dp"
            android:contentDescription="Logo Nomi"
            android:src="@drawable/logo_nomi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TÍTULO DE LA PANTALLA -->
        <TextView
            android:id="@+id/tvTituloRastreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estado de su pedido"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogoRastreo" />

        <!-- CONTENEDOR TARJETA LÍNEA DE TIEMPO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLineaTiempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/app_background"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloRastreo">

            <LinearLayout
                android:id="@+id/llPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Paso 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 1"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="@color/brand_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="1. Recibimos su pedido."
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Paso 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 2"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#555555" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="2. En camino al destino."
                        android:textColor="#888888"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Paso 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 3"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#555555" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="3. Llegó al punto de destino."
                        android:textColor="#888888"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Paso 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 4"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#555555" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="4. Su pedido va en camino."
                        android:textColor="#888888"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GUIDELINE AL 50% -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- IMAGEN DE LA GUÍA O ADJUNTO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvImagenGuia"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#111111"
            app:cardCornerRadius="14dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvLineaTiempo">

            <ImageView
                android:id="@+id/imgGuiaAdjunta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Imagen Guia"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_report_image"
                app:tint="@color/brand_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA DE AYUDA / NOVEDAD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvAyuda"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/brand_primary"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/cvLineaTiempo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Contacto"
                    android:src="@android:drawable/sym_contact_card"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="¿Tiene alguna novedad sobre su pedido?"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>