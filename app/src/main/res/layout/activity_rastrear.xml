<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogoRastreo"
            android:layout_width="65dp"
            android:layout_height="60dp"
            android:contentDescription="Logo Nomi"
            android:src="@drawable/logo_nomi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TÍTULO DE LA PANTALLA -->
        <TextView
            android:id="@+id/tvTituloRastreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="RASTREO DE PEDIDO"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogoRastreo" />

        <!-- CAMPO BÚSQUEDA GUÍA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscarGuia"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Ingrese número de guía (ej. N010001)"
            app:boxStrokeColor="@color/brand_primary"
            app:layout_constraintEnd_toStartOf="@id/btnBuscarGuiaRastreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloRastreo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuiaRastreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarGuiaRastreo"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/brand_primary"
            android:text="BUSCAR"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="@id/tilBuscarGuia"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilBuscarGuia" />

        <!-- INFORMACIÓN RESUMEN PEDIDO -->
        <TextView
            android:id="@+id/tvDetalleGuiaRastreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Guía: -"
            android:textColor="@color/brand_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tilBuscarGuia" />

        <TextView
            android:id="@+id/tvDetalleInfoRastreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingrese una guía para consultar su trazabilidad en tiempo real."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvDetalleGuiaRastreo" />

        <!-- CONTENEDOR TARJETA LÍNEA DE TIEMPO TIPO TEMU -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLineaTiempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/app_surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDetalleInfoRastreo">

            <LinearLayout
                android:id="@+id/llPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Paso 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 1"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="@color/brand_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaso1Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Pedido Registrado en Sistema"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaso1Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recibido en centro de origen"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Paso 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 2"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#555555" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaso2Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Despachado en Planilla de Transporte"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaso2Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="En tránsito entre centros de distribución"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Paso 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 3"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#555555" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaso3Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Arribó a CD Destino / En Reparto"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaso3Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Asignado a mensajero para entrega final"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Paso 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/step4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Paso 4"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#555555" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaso4Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Entregado con Éxito"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaso4Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recibido por el destinatario"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverRastreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/brand_primary"
            android:text="VOLVER AL MENÚ"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/cvLineaTiempo" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>