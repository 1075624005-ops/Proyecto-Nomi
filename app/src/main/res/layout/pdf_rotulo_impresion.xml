<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- CABECERA: LOGO + TÍTULOS + GUÍA + CÓDIGO QR (ARRIBA DERECHA) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LADO IZQUIERDO: LOGO Y TÍTULOS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/llHeaderDerecha"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLogoPdf"
                android:layout_width="50dp"
                android:layout_height="45dp"
                android:contentDescription="Logo"
                android:src="@drawable/logo_nomi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="NOMI"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soluciones a tu alcance"
                android:textColor="#444444"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RÓTULO DE ENVÍO"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LADO DERECHO: NÚMERO DE GUÍA + CÓDIGO QR -->
        <LinearLayout
            android:id="@+id/llHeaderDerecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÚMERO DE GUÍA"
                android:textColor="#666666"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuiaPdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N070002"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- CÓDIGO QR DEL PEDIDO ARRIBA DERECHA -->
            <ImageView
                android:id="@+id/ivQrPdf"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:contentDescription="QR Pedido" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#000000" />

    <!-- SECCIÓN 1: REMITENTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REMITENTE"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRemitentePdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="Nombre:\nDirección de recogida:"
            android:textColor="#222222"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- SECCIÓN 2: DESTINATARIO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENVIAR A (DESTINATARIO)"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDestinatarioPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="Nombre:\nDirección de entrega:\nLocalidad:\nTel:"
            android:textColor="#222222"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- SECCIÓN 3: CONTENIDO Y OBSERVACIONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTENIDO Y OBSERVACIONES"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContenidoPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="-"
            android:textColor="#222222"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#CCCCCC" />

    <!-- SECCIÓN 4: CAJA DE ESTADO DE PAGO / COBRO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_rounded"
        android:backgroundTint="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvEstadoPagoPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAGO CONTRAENTREGA"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMontoPagoPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="COBRAR: $ 51.800,00"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SECCIÓN 5: PIE DE PÁGINA LEGAL -->
    <TextView
        android:id="@+id/tvPieLegalPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Tratamiento de datos conforme a la Ley 1581 de 2012 (Habeas Data)\nNOMI Express - Soluciones a tu alcance"
        android:textColor="#666666"
        android:textSize="10sp" />

</LinearLayout>