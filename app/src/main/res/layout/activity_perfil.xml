<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogoPerfil"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Logo Nomi"
            android:src="@drawable/logo_nomi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MI PERFIL"
            android:textColor="@color/brand_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogoPerfil" />

        <!-- NOMBRE COMPLETO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombre"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Nombre completo"
            android:textColorHint="#888888"
            app:boxBackgroundColor="@color/app_surface_card"
            app:boxStrokeColor="@color/brand_primary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="12dp"
            app:hintTextColor="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPerfil">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="textPersonName"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TIPO DOCUMENTO -->
        <TextView
            android:id="@+id/lbDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipo de Documento"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilNombre" />

        <FrameLayout
            android:id="@+id/flContainerSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/app_surface_card"
            app:layout_constraintTop_toBottomOf="@id/lbDoc">

            <Spinner
                android:id="@+id/spTipoDocPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/brand_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown"
                tools:listitem="@android:layout/simple_spinner_dropdown_item" />
        </FrameLayout>

        <!-- NÚMERO DOCUMENTO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCedula"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Número de Documento"
            android:textColorHint="#888888"
            app:boxBackgroundColor="@color/app_surface_card"
            app:boxStrokeColor="@color/brand_primary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="12dp"
            app:hintTextColor="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/flContainerSpinner">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCedulaPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TELÉFONO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTel"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Teléfono"
            android:textColorHint="#888888"
            app:boxBackgroundColor="@color/app_surface_card"
            app:boxStrokeColor="@color/brand_primary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="12dp"
            app:hintTextColor="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/tilCedula">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelefonoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="phone"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CORREO ELECTRÓNICO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCorreo"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Correo Electrónico"
            android:textColorHint="#888888"
            app:boxBackgroundColor="@color/app_surface_card"
            app:boxStrokeColor="@color/brand_primary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="12dp"
            app:hintTextColor="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/tilTel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN ACTUALIZAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarPerfil"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/brand_primary"
            android:text="ACTUALIZAR DATOS"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilCorreo" />

        <!-- BOTÓN VOLVER -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverPerfil"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="VOLVER AL INICIO"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGuardarPerfil" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>