<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- LOGO (Bajado un poco) -->
        <ImageView
            android:id="@+id/imgLogoPerfil"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_nomi"
            android:layout_marginTop="40dp"
            android:contentDescription="Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TÍTULO (Debajo del logo con espacio) -->
        <TextView
            android:id="@+id/tvTituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MI PERFIL"
            android:textColor="#00AEEF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogoPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- NOMBRE -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Nombre completo"
            android:textColorHint="#888888"
            app:hintTextColor="#00AEEF"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_edit"
            app:endIconTint="#00AEEF"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPerfil"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:focusable="false"
                android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TIPO DOCUMENTO -->
        <TextView android:id="@+id/lbDoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo de Documento" android:textColor="#888888" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/tilNombre" app:layout_constraintStart_toStartOf="parent"/>
        <Spinner
            android:id="@+id/spTipoDocPerfil"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#00AEEF"
            app:layout_constraintTop_toBottomOf="@id/lbDoc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- NÚMERO DOCUMENTO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCedula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Número de Documento"
            android:textColorHint="#888888"
            app:hintTextColor="#00AEEF"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_edit"
            app:endIconTint="#00AEEF"
            app:layout_constraintTop_toBottomOf="@id/spTipoDocPerfil"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCedulaPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:focusable="false"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TELÉFONO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Teléfono"
            android:textColorHint="#888888"
            app:hintTextColor="#00AEEF"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_edit"
            app:endIconTint="#00AEEF"
            app:layout_constraintTop_toBottomOf="@id/tilCedula"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelefonoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:focusable="false"
                android:inputType="phone"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CORREO ELECTRÓNICO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Correo Electrónico"
            android:textColorHint="#888888"
            app:hintTextColor="#00AEEF"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_edit"
            app:endIconTint="#00AEEF"
            app:layout_constraintTop_toBottomOf="@id/tilTel"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:focusable="false"
                android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN ACTUALIZAR -->
        <Button
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ACTUALIZAR DATOS"
            android:backgroundTint="#00AEEF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tilCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BOTÓN VOLVER -->
        <Button
            android:id="@+id/btnVolverPerfil"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VOLVER AL INICIO"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/btnGuardarPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>