<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollDetalles"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:isScrollContainer="true">

    <LinearLayout
        android:id="@+id/containerDetalles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogoDetalles"
            android:layout_width="70dp"
            android:layout_height="65dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Logo Nomi"
            android:src="@drawable/logo_nomi" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTituloDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Detalles del Envío"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- INFORMACIÓN RESUMIDA (REMITENTE Y DESTINATARIO) -->
        <LinearLayout
            android:id="@+id/llResumenActores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- TARJETA REMITENTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/app_background"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/brand_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remitente"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInfoRemitente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nombre: -\nDirección: -"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA DESTINATARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_background"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/brand_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destinatario"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInfoDestinatario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nombre: -\nDirección: -"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- DESCRIPCIÓN EN TARJETA MATERIAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/app_background"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/labelDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Qué envías? (Descripción)"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Ej: Ropa, documentos, repuestos..."
                    android:textColorHint="#888888"
                    app:boxBackgroundColor="@color/app_background"
                    app:boxStrokeColor="@color/text_primary"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:cornerRadius="10dp"
                    app:hintTextColor="@color/text_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescripcionPedido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA MEDIDAS Y PESO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvMedidasPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/app_background"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/labelMedidas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medidas y Peso Real"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/gridMedidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="4">

                    <!-- ANCHO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ancho"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAnchoPedido"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_rounded"
                            android:inputType="numberDecimal"
                            android:padding="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- LARGO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Largo"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etLargoPedido"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_rounded"
                            android:inputType="numberDecimal"
                            android:padding="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ALTO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alto"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAltoPedido"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_rounded"
                            android:inputType="numberDecimal"
                            android:padding="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- PESO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peso Kg"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etPesoPedido"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_rounded"
                            android:inputType="numberDecimal"
                            android:padding="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VALOR DECLARADO DEL PAQUETE -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Valor Declarado del Paquete (COP $)"
            android:textColorHint="#888888"
            app:boxBackgroundColor="@color/app_background"
            app:boxStrokeColor="@color/brand_primary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="10dp"
            app:hintTextColor="@color/brand_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etValorDeclarado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- FORMA DE PAGO -->
        <TextView
            android:id="@+id/labelMetodoPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Forma de Pago del Envío"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPagoYa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_primary"
                android:checked="true"
                android:text="Pago Inmediato"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbPagoContraentrega"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:buttonTint="@color/brand_primary"
                android:text="Contraentrega"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- BOTÓN CALCULAR (UBICADO JUSTO DEBAJO DEL VALOR DECLARADO Y FORMA DE PAGO) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCotizarInterno"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#4CAF50"
            android:text="🧮 CALCULAR TARIFA DE ENVÍO"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- OPCIONES DE TARIFA RESULTANTES -->
        <RadioGroup
            android:id="@+id/rgOpcionesEnvio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rbEstandar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_primary"
                android:text="Económico (2 días hábiles)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbExpress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_primary"
                android:text="Express (1 día hábil)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_primary"
                android:text="Premium Mismo Día"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- BOTÓN RESUMEN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguienteDetalles"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="@color/brand_primary"
            android:text="VER RESUMEN"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>