<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollDetalles"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:isScrollContainer="true">

    <LinearLayout
        android:id="@+id/containerDetalles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogoDetalles"
            android:layout_width="70dp"
            android:layout_height="65dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Logo Nomi"
            android:src="@drawable/logo_nomi" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTituloDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Detalles del Envío"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- INFORMACIÓN RESUMIDA (REMITENTE Y DESTINATARIO) -->
        <LinearLayout
            android:id="@+id/llResumenActores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- TARJETA REMITENTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="12dp"
                app:strokeColor="#00AEEF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remitente"
                        android:textColor="#00AEEF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInfoRemitente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nombre: -\nDirección: -"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA DESTINATARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="12dp"
                app:strokeColor="#00AEEF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destinatario"
                        android:textColor="#00AEEF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInfoDestinatario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nombre: -\nDirección: -"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:id="@+id/labelDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="¿Qué envías? (Descripción)"
            android:textColor="#00AEEF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ej: Ropa, documentos, repuestos..."
            android:textColorHint="#888888"
            app:boxBackgroundColor="#000000"
            app:boxStrokeColor="#00AEEF"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="10dp"
            app:hintTextColor="#00AEEF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MEDIDAS Y PESO -->
        <TextView
            android:id="@+id/labelMedidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Medidas y Peso"
            android:textColor="#00AEEF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/gridMedidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="4">

            <!-- ANCHO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ancho"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAnchoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#000000"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- LARGO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Largo"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etLargoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#000000"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ALTO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alto"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAltoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#000000"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- PESO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peso Kg"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPesoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#000000"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </GridLayout>

        <!-- TABLA DE VALORES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvTablaValoresDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="12dp"
            app:strokeColor="#00AEEF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:text="TABLA DE TARIFAS ESTIMADAS"
                    android:textColor="#00AEEF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <TableRow>
                        <TextView
                            android:padding="4dp"
                            android:text="Peso"
                            android:textColor="#00AEEF"
                            android:textStyle="bold" />
                        <TextView
                            android:gravity="end"
                            android:padding="4dp"
                            android:text="Valor Base"
                            android:textColor="#00AEEF"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="4dp"
                            android:text="Hasta 1 Kg"
                            android:textColor="#FFFFFF" />
                        <TextView
                            android:gravity="end"
                            android:padding="4dp"
                            android:text="$ 10.000"
                            android:textColor="#FFFFFF" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="4dp"
                            android:text="Hasta 2 Kg"
                            android:textColor="#FFFFFF" />
                        <TextView
                            android:gravity="end"
                            android:padding="4dp"
                            android:text="$ 13.000"
                            android:textColor="#FFFFFF" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="4dp"
                            android:text="Hasta 3 Kg"
                            android:textColor="#FFFFFF" />
                        <TextView
                            android:gravity="end"
                            android:padding="4dp"
                            android:text="$ 16.000"
                            android:textColor="#FFFFFF" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:padding="4dp"
                            android:text="Kg Adicional"
                            android:textColor="#4CAF50"
                            android:textStyle="bold" />
                        <TextView
                            android:gravity="end"
                            android:padding="4dp"
                            android:text="+ $ 3.000"
                            android:textColor="#4CAF50" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÓN CALCULAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCotizarInterno"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:text="CALCULAR COSTO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- OPCIONES DE ENVÍO -->
        <RadioGroup
            android:id="@+id/rgOpcionesEnvio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rbEstandar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#00AEEF"
                android:text="Económico"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbExpress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#00AEEF"
                android:text="Express"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#00AEEF"
                android:text="Premium"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- VALOR DECLARADO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Valor Declarado ($)"
            android:textColorHint="#888888"
            app:boxBackgroundColor="#000000"
            app:boxStrokeColor="#00AEEF"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cornerRadius="10dp"
            app:hintTextColor="#00AEEF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etValorDeclarado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- FORMA DE PAGO -->
        <TextView
            android:id="@+id/labelMetodoPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Seleccione Forma de Pago"
            android:textColor="#00AEEF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPagoYa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00AEEF"
                android:checked="true"
                android:text="Pago Inmediato"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbPagoContraentrega"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:buttonTint="#00AEEF"
                android:text="Contraentrega"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- BOTÓN RESUMEN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguienteDetalles"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#00AEEF"
            android:text="VER RESUMEN"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>