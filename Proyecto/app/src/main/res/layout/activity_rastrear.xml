<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- LOGO Y TÍTULO -->
        <ImageView
            android:id="@+id/imgLogoRastreo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_nomi"
            android:contentDescription="Logo Nomi"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTituloRastreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado de su pedido"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogoRastreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- LÍNEA DE TIEMPO (ESTADOS) -->
        <LinearLayout
            android:id="@+id/llPasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloRastreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Paso 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:id="@+id/step1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Paso 1"
                    app:tint="#00AEEF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Recibimos su pedido."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginStart="15dp" />
            </LinearLayout>

            <!-- Paso 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:id="@+id/step2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Paso 2"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. En camino al destino."
                    android:textColor="#888888"
                    android:textSize="18sp"
                    android:layout_marginStart="15dp" />
            </LinearLayout>

            <!-- Paso 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:id="@+id/step3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Paso 3"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Llegó al punto de destino."
                    android:textColor="#888888"
                    android:textSize="18sp"
                    android:layout_marginStart="15dp" />
            </LinearLayout>

            <!-- Paso 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/step4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Paso 4"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Su pedido va en camino."
                    android:textColor="#888888"
                    android:textSize="18sp"
                    android:layout_marginStart="15dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- BOTÓN DE AYUDA -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="#00AEEF"
            app:cardCornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/llPasos"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@android:drawable/sym_contact_card"
                    android:contentDescription="Contacto"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Tiene alguna novedad sobre su pedido?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

        <!-- ESPACIO PARA LA IMAGEN DE LA GUÍA -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginTop="40dp"
            android:src="@android:drawable/ic_menu_report_image"
            android:background="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Imagen Guia"
            app:layout_constraintTop_toBottomOf="@id/llPasos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            android:layout_marginEnd="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>