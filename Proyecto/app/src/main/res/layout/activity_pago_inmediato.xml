<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="PAGO INMEDIATO"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvGuiaPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="N11-000001"
            android:textColor="#888888"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPago"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvMontoAPagar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="$ 0"
            android:textColor="#00AEEF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvGuiaPago"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvCuenta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvMontoAPagar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRANSFIERE A ESTA CUENTA"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivQrPago"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="14dp"
                    android:background="#FFFFFF"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvEntidadCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nequi"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/tvTitularCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nomi App"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvNumeroCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="313 815 0074"
                    android:textColor="#00AEEF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnCopiarNumero"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="COPIAR NÚMERO"
                    android:textSize="11sp"
                    android:backgroundTint="#333333"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvAvisoPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Después de transferir, toca el botón de abajo. Verificaremos tu pago y prepararemos el envío."
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cvCuenta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnYaTransferi"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="YA TRANSFERÍ - CONTINUAR"
            android:backgroundTint="#00AEEF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvAvisoPago"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnEnviarWhatsapp"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="ENVIAR COMPROBANTE POR WHATSAPP"
            android:backgroundTint="#25D366"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnYaTransferi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnCancelarPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CANCELAR"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>